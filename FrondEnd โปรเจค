import React, { useState, useEffect } from 'react';
import { 
  LayoutDashboard, 
  Package, 
  Search,
  BarChart3,
  Building2,
  User,
  LogOut,
  Truck,
  FileText,
  AlertTriangle,
  ChevronRight,
  Database,
  Plus,
  CheckCircle2,
  XCircle,
  ArrowRight,
  TrendingUp,
  Inbox,
  MessageSquare,
  Clock,
  Info,
  Download,
  Mail,
  HardDrive,
  Send,
  History,
  MapPin,
  ShoppingCart,
  Trash2,
  FilePlus2,
  Timer,
  Headset
} from 'lucide-react';

const App = () => {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [currentUser, setCurrentUser] = useState(null);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [searchTerm, setSearchTerm] = useState('');
  const [currentTime, setCurrentTime] = useState(new Date());
  
  // State for Modals
  const [showExportModal, setShowExportModal] = useState(false);
  const [exportStatus, setExportStatus] = useState(null);
  const [showSupportModal, setShowSupportModal] = useState(false);

  // State for inventory requests
  const [requestCart, setRequestCart] = useState([]);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [requestQty, setRequestQty] = useState(1);
  const [requestPriority, setRequestPriority] = useState('normal');
  const [requestNote, setRequestNote] = useState('');

  // Update real-time clock
  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  // Branch list configuration
  const branches = [
    { id: 'BKK_MAIN', name: 'กรุงเทพฯ (สาขาใหญ่)', type: 'main' },
    { id: 'CNX_SUB', name: 'เชียงใหม่ - ภาคเหนือ', type: 'sub', status: 'active' },
    { id: 'AYU_SUB', name: 'พระนครศรีอยุธยา', type: 'sub', status: 'active' },
    { id: 'KOR_SUB', name: 'นครราชสีมา', type: 'sub', status: 'active' },
    { id: 'SUR_SUB', name: 'สุราษฎร์ธานี', type: 'sub', status: 'active' },
  ];

  // Master Stock Database
  const initialProducts = [
    { id: '1', name: 'เสื้อยืด Premium Cotton', sku: 'TS-001', stock: 15, category: 'เครื่องแต่งกาย', price: 250 },
    { id: '2', name: 'กระดาษ A4 80 แกรม', sku: 'PAP-05', stock: 150, category: 'เครื่องใช้สำนักงาน', price: 120 },
    { id: '3', name: 'ปากกาเจลสีน้ำเงิน', sku: 'PEN-12', stock: 50, category: 'เครื่องใช้สำนักงาน', price: 15 },
    { id: '4', name: 'แฟลชไดรฟ์ 32GB', sku: 'FD-32', stock: 500, category: 'อิเล็กทรอนิกส์', price: 350 },
  ];

  // Sub-branch local inventory mockup
  const subBranchInventory = [
    { id: '1', name: 'เสื้อยืด Premium Cotton', sku: 'TS-001', stock: 5, status: 'low' },
    { id: '2', name: 'กระดาษ A4 80 แกรม', sku: 'PAP-05', stock: 45, status: 'normal' },
    { id: '4', name: 'แฟลชไดรฟ์ 32GB', sku: 'FD-32', stock: 12, status: 'low' },
  ];

  const handleLogin = (e) => {
    e.preventDefault();
    const branchId = e.target.branch.value;
    const selectedBranch = branches.find(b => b.id === branchId);
    setCurrentUser(selectedBranch);
    setIsLoggedIn(true);
    setActiveTab('dashboard');
  };

  const handleLogout = () => {
    setIsLoggedIn(false);
    setCurrentUser(null);
    setRequestCart([]);
  };

  const addToCart = () => {
    if (!selectedProduct) return;
    const newItem = {
      ...selectedProduct,
      requestQty: parseInt(requestQty),
      id_temp: Date.now()
    };
    setRequestCart([...requestCart, newItem]);
    setSelectedProduct(null);
    setRequestQty(1);
  };

  const removeFromCart = (idTemp) => {
    setRequestCart(requestCart.filter(item => item.id_temp !== idTemp));
  };

  const handleExportOption = (type) => {
    setExportStatus(`กำลังส่งรายงานผ่าน ${type}...`);
    setTimeout(() => {
      setExportStatus(null);
      setShowExportModal(false);
    }, 2000);
  };

  // --- Login Page Render ---
  if (!isLoggedIn) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-6 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-900/20 via-slate-950 to-slate-950">
        <div className="bg-white w-full max-w-4xl flex rounded-[3rem] shadow-2xl overflow-hidden min-h-[600px]">
          <div className="hidden lg:flex w-1/2 bg-blue-600 p-12 flex-col justify-center text-white relative">
            <div className="bg-white/20 backdrop-blur-md w-16 h-16 rounded-2xl flex items-center justify-center mb-8 border border-white/30">
              <Package size={32} />
            </div>
            <h1 className="text-6xl font-black tracking-tighter leading-none mb-4 uppercase">STOCKPRO<br/>MULTI-NODE</h1>
            {/* Removed v2.5 as requested */}
            <p className="text-blue-100/60 font-bold uppercase tracking-widest text-xs mt-6">ระบบจัดการเครือข่ายคลังสินค้า</p>
          </div>
          <div className="w-full lg:w-1/2 p-12 flex flex-col justify-center bg-white">
            <h2 className="text-4xl font-black text-slate-800 uppercase italic tracking-tight">เข้าสู่ระบบ</h2>
            <form className="mt-8 space-y-5" onSubmit={handleLogin}>
              <div className="space-y-2">
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">เลือกสาขาผู้ใช้งาน</label>
                <select name="branch" className="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none font-bold">
                  {branches.map(b => <option key={b.id} value={b.id}>{b.name}</option>)}
                </select>
              </div>
              <input type="text" placeholder="Username" className="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none" required />
              <input type="password" placeholder="Password" className="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none" required />
              <button type="submit" className="w-full bg-blue-600 hover:bg-blue-700 text-white font-black py-4 rounded-2xl shadow-xl transition-all uppercase tracking-widest">
                Login to Node
              </button>
            </form>
          </div>
        </div>
      </div>
    );
  }

  const isMain = currentUser?.type === 'main';

  return (
    <div className="flex h-screen bg-slate-50 font-sans overflow-hidden">
      {/* Sidebar Navigation */}
      <aside className="w-72 bg-slate-900 flex flex-col shrink-0">
        <div className="p-8 border-b border-slate-800 flex items-center gap-3">
          <div className="bg-blue-600 p-2 rounded-xl"><Package className="text-white" size={24} /></div>
          <span className="text-white font-black text-2xl tracking-tighter uppercase italic">STOCKPRO</span>
        </div>
        <nav className="flex-1 mt-8 px-4 space-y-2">
          <SidebarItem icon={LayoutDashboard} label="DASHBOARD" id="dashboard" activeTab={activeTab} setActiveTab={setActiveTab} />
          {isMain ? (
            <>
              <SidebarItem icon={Database} label="สต็อกส่วนกลาง" id="inventory" activeTab={activeTab} setActiveTab={setActiveTab} />
              <SidebarItem icon={Truck} label="จัดการคำขอสาขา" id="transfer" activeTab={activeTab} setActiveTab={setActiveTab} />
            </>
          ) : (
            <>
              <SidebarItem icon={Package} label={`สต็อกสาขา${currentUser.name.split(' ')[0]}`} id="my_inventory" activeTab={activeTab} setActiveTab={setActiveTab} />
              <SidebarItem icon={Send} label="ส่งคำขอเบิกสินค้า" id="my_requests" activeTab={activeTab} setActiveTab={setActiveTab} />
            </>
          )}
          <SidebarItem icon={FileText} label="รายงานสรุป" id="reports" activeTab={activeTab} setActiveTab={setActiveTab} />
        </nav>
        
        <div className="p-6 space-y-3">
          <button 
            onClick={() => setShowSupportModal(true)}
            className="w-full flex items-center justify-center gap-2 text-blue-400 text-[10px] font-black uppercase tracking-widest bg-blue-500/5 p-4 rounded-2xl hover:bg-blue-500/10 transition-all border border-blue-500/20"
          >
            <Headset size={14} /> ติดต่อผู้ดูแลระบบ
          </button>
          <button onClick={handleLogout} className="w-full flex items-center justify-center gap-2 text-red-400 text-[10px] font-black uppercase tracking-widest bg-slate-800/50 p-4 rounded-2xl hover:bg-red-500/10 transition-all">
            <LogOut size={14} /> Logout
          </button>
        </div>
      </aside>

      {/* Main Content View */}
      <main className="flex-1 overflow-y-auto">
        <header className="bg-white/80 backdrop-blur-md border-b border-slate-200 h-24 flex items-center justify-between px-10 sticky top-0 z-20">
          <div className="flex items-center gap-4">
             <h1 className="font-black text-2xl uppercase tracking-tighter text-slate-900 italic">
               {activeTab === 'dashboard' ? 'แดชบอร์ดสรุปผล' : activeTab === 'inventory' || activeTab === 'my_inventory' ? 'การจัดการสต็อก' : activeTab === 'my_requests' ? 'สร้างรายการเบิกสินค้า' : 'รายงานและสถานะ'}
             </h1>
          </div>
          <div className="flex items-center gap-4">
             <div className="text-right">
                <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest">สาขาที่เข้าใช้งาน</p>
                <p className="text-sm font-black text-blue-600 italic uppercase leading-none mt-1">{currentUser?.name}</p>
             </div>
             <div className="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center text-slate-400 shadow-inner"><User size={20} /></div>
          </div>
        </header>

        <div className="p-10 max-w-[1400px] mx-auto w-full">
          
          {/* DASHBOARD TAB */}
          {activeTab === 'dashboard' && (
            <div className="space-y-8">
               <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                  <StatCard label="เวลาเซิร์ฟเวอร์" value={currentTime.toLocaleTimeString('th-TH')} sub={currentTime.toLocaleDateString('th-TH')} icon={Clock} color="blue" />
                  <StatCard label="สินค้าในมือ" value={isMain ? "2,450" : "62"} sub="รายการพร้อมขาย" icon={Package} color="emerald" />
                  <StatCard label={isMain ? "คำขอรออนุมัติ" : "สถานะคำขอเบิก"} value={isMain ? "12" : "ส่งแล้ว 2"} sub="อัปเดตล่าสุดวันนี้" icon={isMain ? Inbox : Send} color="orange" />
                  <StatCard label="การแจ้งเตือน" value="3" sub="สต็อกต่ำกว่าเกณฑ์" icon={AlertTriangle} color="red" />
               </div>
            </div>
          )}

          {/* SUB-BRANCH LOCAL INVENTORY */}
          {activeTab === 'my_inventory' && !isMain && (
            <div className="space-y-8 animate-in fade-in duration-500">
               <div className="flex justify-between items-center">
                  <div className="relative w-96">
                    <Search className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
                    <input type="text" placeholder={`ค้นหาสต็อกในสาขา ${currentUser.name.split(' ')[0]}...`} className="w-full pl-12 pr-4 py-4 bg-white border border-slate-200 rounded-2xl outline-none shadow-sm" />
                  </div>
                  <button onClick={() => setActiveTab('my_requests')} className="bg-blue-600 text-white px-8 py-4 rounded-2xl font-black uppercase tracking-widest text-xs flex items-center gap-2 shadow-xl shadow-blue-600/20 hover:bg-blue-700 transition-all">
                    <Plus size={18} /> สร้างคำขอเบิกของ
                  </button>
               </div>

               <div className="bg-white rounded-[3rem] border border-slate-200 overflow-hidden shadow-sm">
                  <table className="w-full text-left">
                     <thead className="bg-slate-50/50 text-[10px] font-black uppercase tracking-widest text-slate-400 border-b">
                        <tr>
                           <th className="p-8">รายการสินค้า (Local Stock)</th>
                           <th className="p-8 text-center">SKU</th>
                           <th className="p-8 text-center">จำนวนคงเหลือ</th>
                           <th className="p-8 text-right">สถานะ</th>
                        </tr>
                     </thead>
                     <tbody className="divide-y divide-slate-50">
                        {subBranchInventory.map(item => (
                           <tr key={item.id} className="hover:bg-slate-50/50">
                              <td className="p-8 font-black text-slate-800 italic">{item.name}</td>
                              <td className="p-8 text-center font-mono text-xs text-slate-500">{item.sku}</td>
                              <td className="p-8 text-center font-black text-xl italic">{item.stock}</td>
                              <td className="p-8 text-right">
                                 <span className={`px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest ${item.status === 'low' ? 'bg-red-50 text-red-500' : 'bg-emerald-50 text-emerald-600'}`}>
                                    {item.status === 'low' ? 'ควรเติมสินค้า' : 'ปกติ'}
                                 </span>
                              </td>
                           </tr>
                        ))}
                     </tbody>
                  </table>
               </div>
            </div>
          )}

          {/* REQUEST FORM TAB */}
          {activeTab === 'my_requests' && !isMain && (
             <div className="grid grid-cols-1 lg:grid-cols-12 gap-10 animate-in fade-in duration-500">
                <div className="lg:col-span-7 space-y-8">
                   <div className="bg-white rounded-[3rem] p-10 border border-slate-200 shadow-sm relative overflow-hidden">
                      <div className="flex items-center gap-4 mb-8">
                         <div className="p-3 bg-blue-50 text-blue-600 rounded-2xl"><FilePlus2 size={24} /></div>
                         <div>
                            <h3 className="text-xl font-black text-slate-900 uppercase italic leading-none">เลือกสินค้าจากส่วนกลาง</h3>
                            <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">ส่งคำขอเบิกจากคลังใหญ่ไปยัง {currentUser.name}</p>
                         </div>
                      </div>

                      <div className="space-y-6">
                         <div className="space-y-2">
                            <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">ค้นหา/เลือกสินค้า</label>
                            <select 
                               className="w-full p-5 bg-slate-50 border border-slate-200 rounded-3xl font-black outline-none focus:ring-2 ring-blue-500/20 transition-all appearance-none italic"
                               onChange={(e) => setSelectedProduct(initialProducts.find(p => p.id === e.target.value))}
                               value={selectedProduct?.id || ''}
                            >
                               <option value="">-- คลิกเพื่อเลือกสินค้า --</option>
                               {initialProducts.map(p => <option key={p.id} value={p.id}>{p.name} ({p.sku})</option>)}
                            </select>
                         </div>

                         {selectedProduct && (
                            <div className="bg-slate-50 rounded-[2rem] p-8 border border-slate-100 flex gap-8 animate-in fade-in slide-in-from-top-4 duration-300">
                               <div className="w-32 h-32 bg-white rounded-2xl border border-slate-200 flex items-center justify-center text-slate-300">
                                  <Package size={48} />
                               </div>
                               <div className="flex-1 space-y-4">
                                  <div className="flex justify-between items-start">
                                     <div>
                                        <span className="text-[9px] font-black bg-blue-600 text-white px-2 py-0.5 rounded uppercase">{selectedProduct.category}</span>
                                        <h4 className="text-xl font-black text-slate-900 uppercase italic mt-1">{selectedProduct.name}</h4>
                                        <p className="text-xs font-mono text-slate-400">{selectedProduct.sku}</p>
                                     </div>
                                     <div className="text-right">
                                        <p className="text-[9px] font-black text-slate-400 uppercase">สต็อกกลางปัจจุบัน</p>
                                        <p className="text-2xl font-black text-blue-600 italic">{selectedProduct.stock}</p>
                                     </div>
                                  </div>
                                  <div className="flex items-center gap-6">
                                     <div className="flex-1">
                                        <label className="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1 block">ระบุจำนวนที่ต้องการเบิก</label>
                                        <input 
                                           type="number" 
                                           value={requestQty}
                                           onChange={(e) => setRequestQty(e.target.value)}
                                           min="1"
                                           max={selectedProduct.stock}
                                           className="w-full p-3 bg-white border border-slate-200 rounded-xl font-black text-center"
                                        />
                                     </div>
                                     <button 
                                        onClick={addToCart}
                                        className="h-14 px-8 bg-blue-600 text-white rounded-2xl font-black uppercase tracking-widest text-xs shadow-xl shadow-blue-600/20 hover:scale-105 transition-all flex items-center gap-2"
                                     >
                                        <Plus size={16} /> Add to Order
                                     </button>
                                  </div>
                               </div>
                            </div>
                         )}
                      </div>
                   </div>

                   <div className="bg-slate-900 rounded-[3rem] p-10 text-white relative overflow-hidden">
                      <div className="relative z-10 flex gap-6 items-center">
                         <div className="p-4 bg-white/10 rounded-2xl"><Timer size={24} /></div>
                         <div>
                            <h4 className="text-lg font-black uppercase italic">รอบการส่งของถัดไป</h4>
                            <p className="text-blue-300 text-[10px] font-bold uppercase tracking-[0.2em] mt-1">กำหนดการสำหรับสาขา: พรุ่งนี้ 09:00 น.</p>
                         </div>
                      </div>
                      <div className="absolute -right-20 -bottom-20 w-64 h-64 bg-blue-600/20 rounded-full blur-3xl"></div>
                   </div>
                </div>

                {/* Cart/Summary Section */}
                <div className="lg:col-span-5 space-y-8">
                   <div className="bg-white rounded-[3rem] p-10 border border-slate-200 shadow-sm flex flex-col h-full min-h-[600px]">
                      <div className="flex justify-between items-center mb-8 pb-6 border-b border-slate-100">
                         <h3 className="text-xl font-black text-slate-900 uppercase italic tracking-tighter">Order Summary</h3>
                         <span className="bg-slate-100 text-slate-500 px-3 py-1 rounded-full text-[10px] font-black uppercase">{requestCart.length} รายการ</span>
                      </div>

                      <div className="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
                         {requestCart.length === 0 ? (
                            <div className="h-full flex flex-col items-center justify-center text-slate-300 py-20">
                               <ShoppingCart size={48} className="mb-4 opacity-20" />
                               <p className="text-[10px] font-black uppercase tracking-widest">ยังไม่มีรายการที่เลือก</p>
                            </div>
                         ) : (
                            requestCart.map(item => (
                               <div key={item.id_temp} className="flex items-center gap-4 p-4 bg-slate-50 rounded-2xl border border-transparent hover:border-slate-200 transition-all group">
                                  <div className="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-slate-400 font-black italic shadow-sm group-hover:scale-110 transition-transform">
                                     {item.requestQty}
                                  </div>
                                  <div className="flex-1">
                                     <p className="text-xs font-black text-slate-800 uppercase italic leading-none">{item.name}</p>
                                     <p className="text-[9px] text-slate-400 font-mono mt-1">{item.sku}</p>
                                  </div>
                                  <button onClick={() => removeFromCart(item.id_temp)} className="text-slate-300 hover:text-red-500 transition-colors p-2">
                                     <Trash2 size={16} />
                                  </button>
                               </div>
                            ))
                         )}
                      </div>

                      <div className="mt-8 space-y-6 pt-6 border-t border-slate-100">
                         <div className="grid grid-cols-2 gap-4">
                            <div className="space-y-2">
                               <label className="text-[9px] font-black text-slate-400 uppercase tracking-widest px-1">ความสำคัญ</label>
                               <select 
                                  className={`w-full p-3 rounded-xl font-black text-[10px] uppercase outline-none border transition-all ${requestPriority === 'urgent' ? 'bg-red-50 border-red-200 text-red-600' : 'bg-slate-50 border-slate-200 text-slate-600'}`}
                                  onChange={(e) => setRequestPriority(e.target.value)}
                               >
                                  <option value="normal">ปกติ (Normal)</option>
                                  <option value="urgent">ด่วนพิเศษ (Urgent)</option>
                                </select>
                            </div>
                            <div className="space-y-2 text-right">
                               <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest">ประเมินมูลค่าสินค้า</p>
                               <p className="text-xl font-black text-slate-900 italic">฿{requestCart.reduce((sum, item) => sum + (item.price * item.requestQty), 0).toLocaleString()}</p>
                            </div>
                         </div>
                         
                         <div className="space-y-2">
                            <label className="text-[9px] font-black text-slate-400 uppercase tracking-widest px-1">หมายเหตุ (ถ้ามี)</label>
                            <textarea 
                               placeholder="ระบุหมายเหตุการเบิก..." 
                               className="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-medium outline-none resize-none h-20 focus:bg-white transition-all"
                               onChange={(e) => setRequestNote(e.target.value)}
                            />
                         </div>

                         <button 
                            disabled={requestCart.length === 0}
                            className={`w-full py-5 rounded-[2rem] font-black uppercase tracking-[0.2em] shadow-2xl transition-all flex items-center justify-center gap-3 ${
                               requestCart.length === 0 
                               ? 'bg-slate-100 text-slate-300 cursor-not-allowed' 
                               : 'bg-blue-600 text-white hover:bg-blue-700 hover:-translate-y-1'
                            }`}
                         >
                            <Send size={18} /> Confirm Order
                         </button>
                      </div>
                   </div>
                </div>
             </div>
          )}

          {/* REPORTS TAB */}
          {activeTab === 'reports' && (
             <div className="space-y-8 animate-in fade-in duration-500">
                <div className="flex justify-between items-center">
                   <div>
                      <h2 className="text-3xl font-black text-slate-900 uppercase italic tracking-tighter">Performance Analysis</h2>
                      <p className="text-slate-400 font-bold uppercase text-[10px] tracking-widest mt-1">วิเคราะห์ข้อมูลรายสาขาของ {currentUser?.name}</p>
                   </div>
                   <button onClick={() => setShowExportModal(true)} className="flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-2xl text-[11px] font-black uppercase tracking-widest shadow-xl">
                      <Download size={16} /> Export Reports
                   </button>
                </div>
                <div className="bg-white rounded-[3rem] p-20 border border-slate-200 text-center flex flex-col items-center">
                   <div className="w-24 h-24 bg-slate-50 rounded-[2.5rem] flex items-center justify-center text-slate-200 mb-8 border border-slate-100">
                      <BarChart3 size={48} />
                   </div>
                   <p className="text-slate-300 font-black uppercase tracking-[0.3em] text-sm italic">Analytics Data is Loading for {currentUser?.id}</p>
                </div>
             </div>
          )}
        </div>
      </main>

      {/* Support Modal */}
      {showSupportModal && (
        <div className="fixed inset-0 z-[120] flex items-center justify-center p-6">
          <div className="absolute inset-0 bg-slate-950/60 backdrop-blur-md" onClick={() => setShowSupportModal(false)}></div>
          <div className="bg-white w-full max-w-lg rounded-[3rem] shadow-2xl relative z-10 overflow-hidden flex">
            <div className="w-1/3 bg-blue-600 p-10 flex flex-col justify-center items-center text-white text-center">
              <Headset size={48} className="mb-4" />
              <p className="text-[10px] font-black uppercase tracking-[0.2em] opacity-60">Help Center</p>
              <h4 className="text-xl font-black italic uppercase leading-none mt-2">IT Support</h4>
            </div>
            <div className="flex-1 p-10">
              <h3 className="text-2xl font-black text-slate-900 uppercase italic mb-4">ช่องทางติดต่อ</h3>
              <div className="space-y-6">
                <div className="flex items-center gap-4">
                  <div className="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-blue-600"><Mail size={18} /></div>
                  <div>
                    <p className="text-[9px] font-black text-slate-400 uppercase">Support Email</p>
                    <p className="text-sm font-bold text-slate-800">support@stockpro.com</p>
                  </div>
                </div>
                <div className="flex items-center gap-4">
                  <div className="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-blue-600"><MessageSquare size={18} /></div>
                  <div>
                    <p className="text-[9px] font-black text-slate-400 uppercase">Internal Line</p>
                    <p className="text-sm font-bold text-slate-800">Ext. 9901 (IT Dept)</p>
                  </div>
                </div>
              </div>
              <button onClick={() => setShowSupportModal(false)} className="mt-10 w-full py-4 bg-slate-900 text-white rounded-2xl font-black uppercase tracking-widest text-[10px]">Close Window</button>
            </div>
          </div>
        </div>
      )}

      {/* Export Modal */}
      {showExportModal && (
        <div className="fixed inset-0 z-[110] flex items-center justify-center p-6">
          <div className="absolute inset-0 bg-slate-950/60 backdrop-blur-md" onClick={() => !exportStatus && setShowExportModal(false)}></div>
          <div className="bg-white w-full max-w-md rounded-[3rem] shadow-2xl relative z-10 overflow-hidden p-10 text-center">
            {exportStatus ? (
              <div className="py-10 space-y-6 animate-pulse text-blue-600">
                <Clock size={40} className="animate-spin mx-auto" />
                <p className="text-xl font-black italic uppercase">{exportStatus}</p>
              </div>
            ) : (
              <>
                <Download size={32} className="mx-auto mb-6 text-slate-400" />
                <h3 className="text-2xl font-black text-slate-900 uppercase italic leading-none mb-2">Export Local Node Data</h3>
                <p className="text-slate-400 text-xs font-bold uppercase tracking-widest mb-10">กรุณาเลือกช่องทางการรับรายงาน</p>
                <div className="grid grid-cols-1 gap-4">
                   <ExportBtn onClick={() => handleExportOption('ดาวน์โหลดลงเครื่อง')} icon={HardDrive} label="Download to PC" sub="บันทึกไฟล์ลงใน Node นี้" />
                   <ExportBtn onClick={() => handleExportOption('ส่งผ่าน Gmail')} icon={Mail} label="Cloud Transfer" sub="ส่งไปยังอีเมลผู้ดูแล" />
                </div>
                <button onClick={() => setShowExportModal(false)} className="mt-8 text-[10px] font-black text-slate-300 uppercase tracking-widest hover:text-red-500">Cancel</button>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  );
};

